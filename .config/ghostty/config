# Ghostty config tuned to mirror the existing Alacritty setup closely.
# Tracked via yadm.

config-file = ?font-profile.auto.conf
config-file = ?font-profile.local.conf
font-size = 14
config-file = ?font-size.auto.conf
cursor-style = bar
cursor-style-blink = false

# Auto-switch between Moonfly and Sunfly based on macOS appearance.
theme = dark:Moonfly,light:Sunfly
config-file = ?theme-profile.local.conf

# Match Alacritty's left-option-only Alt behavior.
macos-option-as-alt = left

# Keep the shell explicit.
command = /bin/zsh
shell-integration = zsh

# Similar safety tweak: don't close the terminal with Cmd+W.
keybind = super+w=ignore

# Pi docs recommend this mapping for better terminal ergonomics.
keybind = alt+backspace=text:\x1b\x7f

# Do not let Ctrl-H collapse to the legacy Backspace byte. Send an enhanced
# keyboard-protocol Ctrl-H sequence so TUIs can bind it separately.
keybind = ctrl+h=csi:104;5u
