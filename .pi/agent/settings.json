{
  "theme": "dark",
  "packages": [
    "git:github.com/nicobailon/pi-mcp-adapter",
    "git:github.com/nicobailon/pi-web-access",
    "git:github.com/lajarre/pi-vim",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@dietrichgebert/ponytail",
    "npm:@narumitw/pi-lsp",
    "npm:@juicesharp/rpiv-todo",
    "npm:@juicesharp/rpiv-advisor",
    "npm:@juicesharp/rpiv-btw",
    "git:github.com/bry-guy/pi-sync",
    "npm:pi-lens",
    "npm:pi-observational-memory",
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:pi-worktree-include",
    "npm:@gotgenes/pi-subagents",
    "git:github.com/bry-guy/pi-summarize",
    "git:github.com/bry-guy/pi-keepalive",
    "npm:@diegopetrucci/pi-fast",
    "git:github.com/bry-guy/pi-lab",
    "git:github.com/bry-guy/pi-background",
    "git:github.com/bry-guy/pi-projects"
  ],
  "editorPaddingX": 2,
  "hideThinkingBlock": true,
  "quietStartup": true,
  "treeFilterMode": "default",
  "compaction": {
    "enabled": true,
    "reserveTokens": 68000,
    "keepRecentTokens": 16384
  },
  "enabledModels": [
    "anthropic/claude-opus-5-5",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6-luna"
  ],
  "steeringMode": "all",
  "followUpMode": "all",
  "httpIdleTimeoutMs": 60000,
  "showCacheMissNotices": false,
  "tuiMode": "fullscreen",
  "observational-memory": {
    "model": {
      "provider": "anthropic",
      "id": "claude-haiku-5-5",
      "thinking": "low"
    },
    "showWorkerNotifications": true
  },
  "extensions": [
    "-builtin:mcp"
  ],
  "defaultTools": [
    "+codemode"
  ],
  "cacheWarming": "idle",
  "pi-summarize": {
    "model": "anthropic/claude-haiku-5-5",
    "thinking": "off"
  }
}
