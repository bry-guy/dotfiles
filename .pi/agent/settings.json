{
  "lastChangelogVersion": "0.85.1",
  "theme": "dark",
  "packages": [
    "git:github.com/nicobailon/pi-mcp-adapter",
    "git:github.com/nicobailon/pi-web-access",
    "git:github.com/lajarre/pi-vim",
    "git:github.com/bry-guy/pi-ez-worktree",
    "npm:context-mode",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@dietrichgebert/ponytail",
    "npm:@narumitw/pi-lsp",
    "npm:@juicesharp/rpiv-todo",
    "npm:@juicesharp/rpiv-advisor",
    "npm:@juicesharp/rpiv-btw",
    "npm:@tintinweb/pi-subagents",
    "git:github.com/bry-guy/pi-sync",
    "npm:pi-openai-fast-mode",
    "npm:pi-lens",
    "npm:pi-observational-memory"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "editorPaddingX": 2,
  "hideThinkingBlock": false,
  "quietStartup": true,
  "treeFilterMode": "default",
  "compaction": {
    "enabled": true,
    "reserveTokens": 68000,
    "keepRecentTokens": 16384
  },
  "enabledModels": [
    "openai-codex/gpt-5.5",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-luna"
  ],
  "steeringMode": "all",
  "followUpMode": "all",
  "httpIdleTimeoutMs": 60000,
  "showCacheMissNotices": true,
  "tuiMode": "fullscreen",
  "observational-memory": {
    "observeAfterTokens": 15000,
    "reflectAfterTokens": 30000,
    "compactAfterTokens": 100000,
    "compactAfterTokensMode": "calibrated",
    "compactAfterTokensRatio": 0.68,
    "observationsPoolMaxTokens": 20000,
    "observationsPoolTargetTokens": 10000,
    "agentMaxTurns": 16,
    "model": {
      "provider": "openai-codex",
      "id": "gpt-5.6-luna",
      "thinking": "high"
    },
    "showWorkerNotifications": true,
    "passive": false,
    "debugLog": false
  }
}
