{
  "theme": "dark",
  "terminal": {
    "hyperlinks": true
  },
  "packages": [
    "git:github.com/nicobailon/pi-mcp-adapter",
    "git:github.com/nicobailon/pi-web-access",
    "git:github.com/lajarre/pi-vim",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@dietrichgebert/ponytail",
    "npm:@narumitw/pi-lsp",
    "npm:@juicesharp/rpiv-todo",
    "npm:@juicesharp/rpiv-advisor",
    "npm:@juicesharp/rpiv-btw",
    "git:github.com/bry-guy/pi-sync",
    "npm:pi-lens",
    "git:github.com/bry-guy/pi-observational-memory",
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:pi-worktree-include",
    "npm:@gotgenes/pi-subagents",
    "git:github.com/bry-guy/pi-summarize",
    "git:github.com/bry-guy/pi-keepalive",
    "npm:@diegopetrucci/pi-fast",
    "git:github.com/bry-guy/pi-lab",
    "git:github.com/bry-guy/pi-background",
    "git:github.com/bry-guy/pi-projects",
    "git:github.com/bry-guy/pi-mounts",
    "git:github.com/bry-guy/pi-secret-broker",
    "npm:pi-antigravity"
  ],
  "editorPaddingX": 2,
  "hideThinkingBlock": true,
  "quietStartup": true,
  "treeFilterMode": "default",
  "compaction": {
    "enabled": true,
    "reserveTokens": 68000,
    "keepRecentTokens": 16384
  },
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "anthropic/claude-opus-5-5",
    "anthropic/claude-fable-5-2",
    "openai-codex/gpt-6.2-sol",
    "openai-codex/gpt-6.2-astra",
    "antigravity/gemini-4-hydrogen",
    "antigravity/gemini-4-neon",
    "anthropic/claude-haiku-5-5"
  ],
  "steeringMode": "all",
  "followUpMode": "all",
  "httpIdleTimeoutMs": 60000,
  "showCacheMissNotices": false,
  "tuiMode": "fullscreen",
  "observational-memory": {
    "model": {
      "provider": "anthropic",
      "id": "claude-haiku-5-5",
      "thinking": "low"
    },
    "showWorkerNotifications": false,
    "observeThinking": true,
    "debugLog": true
  },
  "extensions": [
    "-builtin:mcp"
  ],
  "defaultTools": [
    "+codemode"
  ],
  "cacheWarming": "idle",
  "pi-summarize": {
    "model": "anthropic/claude-haiku-5-5",
    "thinking": "off"
  },
  "pi-keepalive": {
    "linger": "30m"
  },
  "extensionChangelogVersions": {
    "{\"source\":\"git:github.com/nicobailon/pi-mcp-adapter\",\"scope\":\"user\"}": "7.0.1",
    "{\"source\":\"git:github.com/nicobailon/pi-web-access\",\"scope\":\"user\"}": "0.47.0",
    "{\"source\":\"npm:@narumitw/pi-lsp\",\"scope\":\"user\"}": "0.49.12",
    "{\"source\":\"npm:pi-lens\",\"scope\":\"user\"}": "4.4.11",
    "{\"source\":\"npm:@gotgenes/pi-anthropic-auth\",\"scope\":\"user\"}": "3.4.4",
    "{\"source\":\"npm:@gotgenes/pi-subagents\",\"scope\":\"user\"}": "25.0.5",
    "{\"source\":\"git:github.com/bry-guy/pi-secret-broker\",\"scope\":\"user\"}": "0.3.0"
  },
  "warnings": {
    "anthropicExtraUsage": false
  }
}
