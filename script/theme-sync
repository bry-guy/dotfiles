#!/bin/bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: ~/script/theme-sync [auto|dark|light|status]

Synchronizes the local terminal theme projection. `auto` detects macOS or
Linux appearance; an explicit mode is useful for testing. Running `status`
reports the last applied appearance and display profile.
EOF
}

home_dir="$HOME"
state_dir="${XDG_STATE_HOME:-$home_dir/.local/state}/dotfiles"
state_file="$state_dir/theme-sync"
lock_file="$state_dir/theme-sync.lock"

read_state() {
  [[ -f "$state_file" ]] || return 0
  while IFS='=' read -r key value; do
    case "$key" in
      appearance) saved_appearance="$value" ;;
      display) saved_display="$value" ;;
      font_recommendation) saved_font_recommendation="$value" ;;
      font_profile) saved_font_profile="$value" ;;
    esac
  done < "$state_file"
}

if [[ "${1:-auto}" == "status" ]]; then
  saved_appearance="unknown"
  saved_display="unknown"
  saved_font_recommendation="unknown"
  saved_font_profile="unknown"
  read_state
  printf 'Theme sync state: appearance=%s display=%s recommended-font=%s actual-font=%s\n' \
    "$saved_appearance" "$saved_display" "$saved_font_recommendation" "$saved_font_profile"
  exit 0
fi

detect_appearance() {
  case "$(uname -s)" in
    Darwin)
      if defaults read -g AppleInterfaceStyle >/dev/null 2>&1; then
        echo dark
      else
        echo light
      fi
      ;;
    Linux)
      if command -v darkman >/dev/null 2>&1; then
        darkman get 2>/dev/null || echo dark
        return
      fi

      if command -v gsettings >/dev/null 2>&1; then
        local scheme
        scheme="$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null || true)"
        if [[ "$scheme" == *dark* ]]; then
          echo dark
        else
          echo light
        fi
        return
      fi

      echo dark
      ;;
    *)
      echo dark
      ;;
  esac
}

detect_display() {
  if [[ -x "$home_dir/script/display-profile" ]]; then
    "$home_dir/script/display-profile"
  else
    echo other
  fi
}

mode="${1:-auto}"
case "$mode" in
  -h|--help)
    usage
    exit 0
    ;;
  auto)
    mode="$(detect_appearance)"
    ;;
  dark|light)
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac

display="$(detect_display)"
if [[ "$display" == "studio" ]]; then
  font_profile="sfmono-thick"
else
  font_profile="sfmono"
fi

mkdir -p "$state_dir"
lock_acquired=false
lock_temp="$lock_file.$$"
printf '%s\n' "$$" > "$lock_temp"
for _ in {1..100}; do
  if ln "$lock_temp" "$lock_file" 2>/dev/null; then
    lock_acquired=true
    break
  fi

  lock_pid="$(cat "$lock_file" 2>/dev/null || true)"
  if [[ ! "$lock_pid" =~ ^[0-9]+$ ]] || ! kill -0 "$lock_pid" 2>/dev/null; then
    rm -f "$lock_file"
  fi
  sleep 0.1
done
rm -f "$lock_temp"
if [[ "$lock_acquired" != true ]]; then
  echo "theme-sync could not acquire its reconciliation lock." >&2
  exit 1
fi
release_lock() {
  if [[ "$(cat "$lock_file" 2>/dev/null || true)" == "$$" ]]; then
    rm -f "$lock_file"
  fi
}
trap release_lock EXIT

selected_theme="$([[ "$mode" == dark ]] && echo moonfly || echo sunfly)"
pi_theme="$home_dir/.pi/agent/themes/adaptive.json"
pi_source="$home_dir/.pi/agent/themes/$selected_theme.json"
claude_theme="$home_dir/.claude/themes/adaptive.json"
claude_source="$home_dir/.claude/themes/$selected_theme.json"
posting_theme="$home_dir/.local/share/posting/themes/adaptive.yaml"
posting_source="$home_dir/.local/share/posting/themes/$selected_theme.yaml"
tmux_theme_source="$home_dir/.config/tmux/theme.$([[ "$mode" == dark ]] && echo dark || echo light).conf"
tmux_theme_target="$home_dir/.config/tmux/theme.conf"
ghostty_theme_override="$home_dir/.config/ghostty/theme-profile.local.conf"

for source in "$pi_source" "$claude_source" "$posting_source" "$tmux_theme_source"; do
  [[ -f "$source" ]] || { echo "Missing theme source: $source" >&2; exit 1; }
done

atomic_write() {
  local destination="$1"
  local temporary
  mkdir -p "$(dirname "$destination")"
  temporary="$(mktemp "${destination}.tmp.XXXXXX")"
  cat > "$temporary"
  if [[ -f "$destination" ]] && cmp -s "$temporary" "$destination"; then
    rm -f "$temporary"
    return
  fi
  chmod 644 "$temporary"
  mv "$temporary" "$destination"
}

# A stable active theme name lets applications reload the projection in place.
python3 - "$pi_source" "$pi_theme" "$claude_source" "$claude_theme" "$posting_source" "$posting_theme" <<'PY'
import json
import os
from pathlib import Path
import re
import sys
import tempfile

pi_source, pi_target, claude_source, claude_target, posting_source, posting_target = map(Path, sys.argv[1:7])


def replace_atomically(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists() and path.read_text() == text:
        return
    temporary = None
    try:
        with tempfile.NamedTemporaryFile("w", dir=path.parent, prefix=f".{path.name}.", delete=False) as file:
            file.write(text)
            temporary = Path(file.name)
        os.chmod(temporary, 0o644)
        os.replace(temporary, path)
        temporary = None
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


pi = json.loads(pi_source.read_text())
pi["name"] = "adaptive"
replace_atomically(pi_target, json.dumps(pi, indent=2) + "\n")

claude = json.loads(claude_source.read_text())
claude["name"] = "Adaptive"
replace_atomically(claude_target, json.dumps(claude, indent=2) + "\n")

posting = posting_source.read_text()
posting, count = re.subn(r"(?m)^name:\s*.*$", "name: adaptive", posting, count=1)
if count != 1:
    raise SystemExit(f"Posting theme source has no name field: {posting_source}")
replace_atomically(posting_target, posting)
PY

# Theme selections live in tracked settings; runtime sync only replaces the
# ignored adaptive projections above.
atomic_write "$tmux_theme_target" < "$tmux_theme_source"
if [[ "${1:-auto}" == "auto" ]]; then
  rm -f "$ghostty_theme_override"
else
  atomic_write "$ghostty_theme_override" <<EOF
# Temporary explicit appearance override from theme-sync $mode.
theme = $([[ "$mode" == dark ]] && echo Moonfly || echo Sunfly)
EOF
fi
tmux_status="theme-file updated"
if command -v tmux >/dev/null 2>&1 && tmux ls >/dev/null 2>&1; then
  if tmux source-file "$home_dir/.tmux.conf" >/dev/null 2>&1; then
    tmux_status="reloaded"
  else
    tmux_status="theme-file updated (reload failed)"
  fi
fi

nvim_status="state published"
if command -v nvim >/dev/null 2>&1 && compgen -G '/tmp/nvim*.sock' >/dev/null; then
  nvim_status="reloaded"
  for socket in /tmp/nvim*.sock; do
    nvim --server "$socket" --remote-send "<Cmd>lua require('config.theme').apply()<CR>" >/dev/null 2>&1 || nvim_status="some servers unavailable"
  done
fi

font_status="not configured"
actual_font_profile="unknown"
ghostty_status="not running"
if [[ "$(uname -s)" == "Darwin" ]]; then
  if [[ -x "$home_dir/script/ghostty-font" ]]; then
    font_output="$(DOTFILES_DISPLAY="$display" "$home_dir/script/ghostty-font" sync 2>&1)"
    font_status="$font_output"
    actual_font_profile="$("$home_dir/script/ghostty-font" status-name)"
  fi
  if pgrep -x ghostty >/dev/null 2>&1; then
    if pkill -USR2 -x ghostty >/dev/null 2>&1; then
      ghostty_status="theme/font reload signal sent"
    else
      ghostty_status="theme/font reload signal failed"
    fi
  else
    ghostty_status="not running"
  fi
fi

# The launcher watches this state and updates already-running Neovim and
# Harlequin instances. It is also the source for the next process startup.
atomic_write "$state_file" <<EOF
appearance=$mode
display=$display
font_recommendation=$font_profile
font_profile=$actual_font_profile
updated_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF

cat <<EOF
Synced appearance: $mode
display: $display
recommended font: $font_profile
actual font: $actual_font_profile
- Neovim: $selected_theme ($nvim_status)
- Pi: adaptive -> $selected_theme (active file; existing sessions may need /reload)
- Posting: adaptive -> $selected_theme (active file watcher; restart if stale)
- Harlequin: adaptive -> $selected_theme (state watcher)
- tmux: $tmux_status
- Ghostty: Moonfly/Sunfly native; $ghostty_status
- Ghostty font: $font_status
- Claude Code: adaptive -> $mode (file updated; existing sessions need restart or select custom:adaptive once)
EOF
