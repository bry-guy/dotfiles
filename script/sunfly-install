#!/bin/bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: ~/script/sunfly-install [--ref <git-ref>] [--source-dir <path>] <extra> [<extra> ...]

Update tracked local Sunfly config files from the public bry-guy/sunfly repository
or from a local checkout.

Extras:
  ghostty   -> updates ~/.config/ghostty/themes/Sunfly
  pi        -> updates ~/.pi/agent/themes/sunfly.json
  posting   -> updates ~/.local/share/posting/themes/sunfly.yaml
  tmux      -> updates ~/.config/tmux/theme.light.conf
  claude    -> updates ~/.claude/themes/sunfly.json
  harlequin -> updates ~/.config/harlequin/sunfly_textual_themes.py
  all       -> installs all extras above

Examples:
  ~/script/sunfly-install ghostty pi claude
  ~/script/sunfly-install all
  ~/script/sunfly-install --source-dir ~/.local/share/nvim/lazy/sunfly all

Environment:
  SUNFLY_REPO        Override GitHub repo (default: bry-guy/sunfly)
  SUNFLY_REF         Override git ref/tag (default: main)
  SUNFLY_SOURCE_DIR  Copy files from a local checkout instead of GitHub
EOF
}

repo="${SUNFLY_REPO:-bry-guy/sunfly}"
ref="${SUNFLY_REF:-main}"
source_dir="${SUNFLY_SOURCE_DIR:-}"
extras=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --ref)
      [[ $# -ge 2 ]] || { echo "Missing value for --ref" >&2; exit 1; }
      ref="$2"
      shift 2
      ;;
    --source-dir)
      [[ $# -ge 2 ]] || { echo "Missing value for --source-dir" >&2; exit 1; }
      source_dir="$2"
      shift 2
      ;;
    ghostty|pi|posting|tmux|claude|harlequin|all)
      extras+=("$1")
      shift
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

[[ ${#extras[@]} -gt 0 ]] || { echo "Specify at least one extra to install." >&2; usage >&2; exit 1; }

if [[ -z "$source_dir" ]] && ! command -v curl >/dev/null 2>&1; then
  echo "curl is required for remote sunfly-install" >&2
  exit 1
fi

fetch() {
  local src="$1" output="$2"
  if [[ -n "$source_dir" ]]; then
    local local_src="${source_dir%/}/${src}"
    [[ -f "$local_src" ]] || { echo "Missing local Sunfly file: $local_src" >&2; exit 1; }
    cp "$local_src" "$output"
  else
    local url="https://raw.githubusercontent.com/${repo}/${ref}/${src}"
    curl -fsSL "$url" -o "$output"
  fi
}

install_file() {
  local label="$1" src="$2" dest="$3"
  local tmp
  tmp="$(mktemp)"
  mkdir -p "$(dirname "$dest")"
  fetch "$src" "$tmp"
  mv "$tmp" "$dest"
  chmod 644 "$dest"
  echo "Updated ${label}: ${dest}"
}

expanded=()
for extra in "${extras[@]}"; do
  if [[ "$extra" == "all" ]]; then
    expanded+=(ghostty pi posting tmux claude harlequin)
  else
    expanded+=("$extra")
  fi
done

seen=" "
unique=()
for extra in "${expanded[@]}"; do
  if [[ "$seen" != *" $extra "* ]]; then
    unique+=("$extra")
    seen+="$extra "
  fi
done

for extra in "${unique[@]}"; do
  case "$extra" in
    ghostty)
      install_file "ghostty" "extras/ghostty/Sunfly" "$HOME/.config/ghostty/themes/Sunfly"
      rm -f "$HOME/.config/ghostty/themes/Sunfly Paper" "$HOME/.config/ghostty/themes/Sunfly Bright" "$HOME/.config/ghostty/themes/Sunfly Crisp"
      ;;
    pi)
      install_file "pi" "extras/pi/sunfly.json" "$HOME/.pi/agent/themes/sunfly.json"
      rm -f "$HOME/.pi/agent/themes/sunfly-paper.json" "$HOME/.pi/agent/themes/sunfly-bright.json"
      ;;
    posting)
      install_file "posting" "extras/posting/sunfly.yaml" "$HOME/.local/share/posting/themes/sunfly.yaml"
      rm -f "$HOME/.local/share/posting/themes/sunfly-paper.yaml" "$HOME/.local/share/posting/themes/sunfly-bright.yaml"
      ;;
    tmux)
      install_file "tmux" "extras/tmux/sunfly.conf" "$HOME/.config/tmux/theme.light.conf"
      rm -f "$HOME/.config/tmux/theme.light.paper.conf" "$HOME/.config/tmux/theme.light.bright.conf"
      ;;
    claude)
      install_file "claude" "extras/claude/sunfly.json" "$HOME/.claude/themes/sunfly.json"
      rm -f "$HOME/.claude/themes/sunfly-paper.json" "$HOME/.claude/themes/sunfly-bright.json"
      ;;
    harlequin)
      install_file "harlequin" "extras/harlequin-textual/sunfly_textual_themes.py" "$HOME/.config/harlequin/sunfly_textual_themes.py"
      ;;
  esac
done

source_label="${repo}@${ref}"
[[ -n "$source_dir" ]] && source_label="$source_dir"
echo "Sunfly extras updated from ${source_label}."
