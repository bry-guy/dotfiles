Include ~/.colima/ssh_config
Include ~/.ssh/config.identity

# Agent shells (AGENT_ROLE set by a project's .envrc) never use Bryan's 1Password SSH keys.
Match exec "test -n \"$AGENT_ROLE\""
	IdentityAgent none

Host *
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
