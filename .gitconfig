[pull]
		ff = only
[include]
		path = ~/.gitconfig.identity.local
		path = ~/.gitconfig.darwin
[includeIf "hasconfig:remote.*.url:git@lumora.ghe.com:*/**"]
		path = ~/.gitconfig.identity.work
[includeIf "hasconfig:remote.*.url:ssh://git@lumora.ghe.com/**"]
		path = ~/.gitconfig.identity.work
[includeIf "hasconfig:remote.*.url:lumora@lumora.ghe.com:*/**"]
		path = ~/.gitconfig.identity.work
[alias]
		co = checkout
		br = branch
		ci = commit
		st = status
		wt = worktree
		tg = tag --sort=-v:refname
		unstage = reset HEAD --
		last = log -1 HEAD
		forget = update-index --assume-unchanged
		remember = update-index --no-assume-unchanged
		forgotten = ! git ls-files -v | grep "^h "

        recent-remote = ! git for-each-ref --sort=-committerdate --format='%(committerdate:iso)|%(authorname)|%(refname:short)' refs/heads/ refs/remotes/ | grep -v 'dependabot' | head -15 | column -t -s '|'
        recent = ! git branch --sort=-committerdate --format='%(committerdate:iso)|%(authorname)|%(refname:short)' | head -15 | column -t -s '|'


        re = recent
        rerem = recent-remote
[core]
	excludesFile = /Users/bryan/.gitignore
[init]
		defaultBranch = main


[merge]
  tool = vimdiff
[mergetool]
  prompt = true
[mergetool "vimdiff"]
  cmd = nvim -d $BASE $LOCAL $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'

[diff]
  tool = vimdiff
[difftool]
  prompt = true
[difftool "vimdiff"]
  cmd = nvim -d $BASE $LOCAL $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'
